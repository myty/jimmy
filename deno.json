{
  "tasks": {
    "clear-cache": "deno run --unstable --allow-net ./scripts/clear-readme-cache.ts"
  },
  "compilerOptions": {
    "allowJs": false,
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "workspace": [
    "./samples",
    "./src"
  ],
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41.3"
  }
}
